# Copy to .env and fill in. Nothing here is required to run with EXTRACTOR=null.

# ---- service
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text
DATA_DIR=./data
MAX_UPLOAD_BYTES=104857600
MAX_PAGES=1000
RUN_WORKER_IN_PROCESS=true

# `null` runs the whole service with no provider calls. `pipeline` does real extraction.
EXTRACTOR=pipeline

# ---- retention (parked: 0 means never expire)
RESULT_TTL_HOURS=0
DELETE_UPLOAD_ON_SUCCESS=false

# ---- extraction
EXTRACTION_MODE_DEFAULT=balanced
VISION_CONCURRENCY=8
RENDER_SCALE=4.0
ROWS_PER_STRIP=22
MAX_STRIPS=8
STRIP_OVERLAP=0.04
ROUTER_MIN_TABLE_ROWS=3
ROUTER_MIN_TABLE_COLS=2
ROUTER_MIN_SHORT_LINES=30
GROUND_IDENTIFIERS=true
GROUND_NUMBERS=false
IDENTIFIER_MIN_SIMILARITY=0.62
IDENTIFIER_MARGIN=0.08
MAX_NEST_DEPTH=3
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE_HINT=

# ---- providers (API keys in v1; leave a key blank to use DefaultAzureCredential)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
FOUNDRY_VISION_DEPLOYMENT=
FOUNDRY_MERGE_DEPLOYMENT=
